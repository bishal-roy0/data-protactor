# Optional external enrichment. Leave these blank to use Karna's local fallback analysis.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
VIRUSTOTAL_API_KEY=

# Optional, authorized internal simulation metadata only. Never used by /analyze.
GOPHISH_API_URL=
GOPHISH_API_KEY=
GOPHISH_SIMULATION_ENABLED=false

# Public URL for a tested, signed Karna Android release. Leave blank until one exists.
ANDROID_APP_DOWNLOAD_URL=

# Optional application configuration.
APP_NAME=Karna
ENVIRONMENT=development
LOG_LEVEL=INFO
